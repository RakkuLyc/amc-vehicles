# Editor settings for AMC Vehicles (the user's choice, 2026-11-19: no automatic formatter, only this file).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{java,py,txt,gradle}]
max_line_length = 120

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2
